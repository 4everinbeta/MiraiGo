{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TravelPlannerState",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "user_intent": { "type": "string" },
    "trip_type": { "type": "string", "enum": ["leisure", "romantic", "family", "friends", "solo", "other"] },
    "date_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "description": "ISO date YYYY-MM-DD" },
        "end": { "type": "string", "description": "ISO date YYYY-MM-DD" },
        "flexible_days": { "type": "integer", "minimum": 0 }
      },
      "required": ["start", "end", "flexible_days"]
    },
    "trip_length_days": { "type": ["integer", "null"], "minimum": 1 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": { "type": "string" },
        "airport": { "type": "string", "description": "IATA code if known" }
      },
      "required": ["city", "airport"]
    },
    "travelers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adults": { "type": "integer", "minimum": 1 },
        "children": { "type": "integer", "minimum": 0 },
        "child_ages": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 17 } }
      },
      "required": ["adults", "children", "child_ages"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": { "type": "string" },
        "min": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["number", "null"], "minimum": 0 },
        "comfort": { "type": "string", "enum": ["value", "mid", "premium", "luxury"] }
      },
      "required": ["currency", "min", "max", "comfort"]
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "climate": { "type": "string" },
        "pace": { "type": "string", "enum": ["relaxed", "balanced", "packed"] },
        "interests": { "type": "array", "items": { "type": "string" } },
        "hotel_type": { "type": "string", "enum": ["hotel", "resort", "boutique", "all-inclusive", "apartment"] },
        "flight_constraints": { "type": "array", "items": { "type": "string" } },
        "accessibility_needs": { "type": "string" }
      },
      "required": ["climate", "pace", "interests", "hotel_type", "flight_constraints", "accessibility_needs"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passport_ok": { "type": ["boolean", "null"] },
        "max_flight_hours": { "type": ["number", "null"], "minimum": 0 },
        "avoid": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["passport_ok", "max_flight_hours", "avoid"]
    },
    "candidate_destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "destination": { "type": "string" },
          "why_it_fits": { "type": "array", "items": { "type": "string" } },
          "best_for": { "type": "array", "items": { "type": "string" } },
          "risk_notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["destination", "why_it_fits", "best_for", "risk_notes"]
      }
    },
    "quotes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retrieved_at": { "type": "string" },
        "currency": { "type": "string" },
        "packages": { "type": "array" }
      },
      "required": ["retrieved_at", "currency", "packages"]
    },
    "itineraries": { "type": "array" },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "user_visible_disclaimers": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "user_intent",
    "trip_type",
    "date_window",
    "trip_length_days",
    "origin",
    "travelers",
    "budget",
    "preferences",
    "constraints",
    "candidate_destinations",
    "quotes",
    "itineraries",
    "open_questions",
    "assumptions",
    "user_visible_disclaimers"
  ]
}